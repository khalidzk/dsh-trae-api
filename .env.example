# Trae Local API 配置
# ============================================
# TRAE_EDITION 取值:
#   cn      - Trae CN 国内版 (目录: Trae CN, tc 加密)
#   solo    - TRAE SOLO CN 独立部署版 (目录: TRAE SOLO CN, tc 加密)
#   sg      - Trae 国际版 (目录: Trae, 明文 JSON)
#   solo-sg - TRAE SOLO 国际版 (目录: TRAE SOLO, tc 加密)
# ============================================

# Trae 版本 (自动检测时此值会被覆盖)
TRAE_EDITION=cn

# 本服务的 API Key (客户端请求时需携带；设为 none 可禁用鉴权，不推荐)
API_KEY=trae-local-api

# 监听端口
PORT=9220

# 监听地址 (默认 127.0.0.1 仅本机访问；设为 0.0.0.0 开放局域网，需自担风险)
# HOST=127.0.0.1

# ============================================
# 上游通道选择 (企业版/个人版计量)
# ============================================
# TRAE_CHANNEL 取值:
#   agent - 企业网关 create_agent_task 通道 (默认)。
#           使用 console.enterprise.trae.cn，走企业版额度（SOLO 并发限流模式，
#           不扣个人 fast request 配额）。支持工具调用（客户端工具经
#           <tool_use> 标签协议注入）。
#   llm   - 原 llm_utils_chat 通道 (trae-api-cn.mchost.guru)。
#           走个人版每日 fast request 配额，仅在排障时对比使用。
#TRAE_CHANNEL=agent

# ============================================
# 以下字段由 setup.js 自动填充，无需手动修改
# ============================================

# 自动解密后的 JWT Token
# TRAE_TOKEN=eyJ...

# 刷新 Token
# TRAE_REFRESH_TOKEN=...

# 用户 ID
# TRAE_USER_ID=...

# Token 过期时间 (ISO 8601)
# TRAE_TOKEN_EXPIRES=...

# Refresh Token 过期时间
# TRAE_REFRESH_EXPIRES=...

# ============================================
# 高级选项 (可选)
# ============================================

# 上游 API 地址 (仅 llm 通道使用；agent 通道固定为企业网关，无需修改)
# BASE_URL=https://trae-api-cn.mchost.guru

# 最大上下文 Token 数 (默认 128000；过大导致上游 prefill 延迟明显，128k 平衡首 token 延迟与长度)
# MAX_CONTEXT_TOKENS=128000

# 调试：转储 agent 通道上游原始 SSE 流与渲染后的 transcript
# 设置为文件路径前缀，生成 <前缀>.raw.sse 和 <前缀>.transcript.txt 两个文件
# TRAE_DEBUG_RAW=/tmp/trae-debug

# 如果自动解密失败，可手动设置 Token
# TRAE_MANUAL_TOKEN=eyJ...
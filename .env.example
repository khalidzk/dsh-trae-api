# Trae Local API 配置
# ============================================
# TRAE_EDITION 取值:
#   cn      - Trae CN 国内版 (目录: Trae CN, tc 加密)
#   solo    - TRAE SOLO CN 独立部署版 (目录: TRAE SOLO CN, tc 加密)
#   sg      - Trae 国际版 (目录: Trae, 明文 JSON)
#   solo-sg - TRAE SOLO 国际版 (目录: TRAE SOLO, tc 加密)
# ============================================

# Trae 版本 (自动检测时此值会被覆盖)
TRAE_EDITION=cn

# 本服务的 API Key (客户端请求时需携带；设为 none 可禁用鉴权，不推荐)
API_KEY=trae-local-api

# 监听端口
PORT=9220

# 监听地址 (默认 127.0.0.1 仅本机访问；设为 0.0.0.0 开放局域网，需自担风险)
# HOST=127.0.0.1

# ============================================
# 以下字段由 setup.js 自动填充，无需手动修改
# ============================================

# 自动解密后的 JWT Token
# TRAE_TOKEN=eyJ...

# 刷新 Token
# TRAE_REFRESH_TOKEN=...

# 用户 ID
# TRAE_USER_ID=...

# Token 过期时间 (ISO 8601)
# TRAE_TOKEN_EXPIRES=...

# Refresh Token 过期时间
# TRAE_REFRESH_EXPIRES=...

# ============================================
# 高级选项 (可选)
# ============================================

# 上游 API 地址 (一般无需修改)
# BASE_URL=https://trae-api-cn.mchost.guru

# 最大上下文 Token 数 (默认 200000)
# MAX_CONTEXT_TOKENS=200000

# 如果自动解密失败，可手动设置 Token
# TRAE_MANUAL_TOKEN=eyJ...
{
  "name": "@casually/dsh-trae-api",
  "version": "1.1.1",
  "description": "DSH plugin: expose Trae Work CN credits as a local OpenAI/Anthropic compatible API for Claude Code, Cursor, Cline and other agents. Ships a DSH web settings page (status, stats, token management, hot-reload config).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "client.js",
    "cordis.patch.yml",
    "setup.js",
    "start.bat",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "node setup.js",
    "start": "node src/server.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "dotenv": "^16.4.0",
    "uuid": "^10.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Casually/dsh-trae-api.git"
  },
  "bugs": {
    "url": "https://github.com/Casually/dsh-trae-api/issues"
  },
  "homepage": "https://github.com/Casually/dsh-trae-api#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "trae",
    "openai",
    "anthropic",
    "proxy",
    "llm",
    "settings-page"
  ]
}
